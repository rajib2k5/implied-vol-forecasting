{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajib2k5/implied-vol-forecasting/schemas/app-data/error_surface.schema.json",
  "title": "error_surface.json",
  "description": "3D error surface: dense cubes indexed [period][model][horizon][regime] following the axis arrays. null = suppressed (n < min_cell_n, a local reliability rule) or not applicable. license_class: aggregate. The real version holds regime cells, so it is written only outside the repo and never committed (ADR 0001 D2: not in the publication set P; amended M0, review D). Invariants checked outside the schema: every cube's shape equals (len(periods), len(models), len(horizons), len(regimes)). See data-model.md 5.4.",
  "$ref": "envelope.schema.json",
  "type": "object",
  "properties": {
    "dataset": { "const": "error_surface" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periods", "regimes", "surfaces"],
      "properties": {
        "periods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "envelope.schema.json#/$defs/period" }
        },
        "regimes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regime" }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" }
        }
      }
    },
    "regime": {
      "description": "Regimes from different schemes overlap (slices, not a partition).",
      "type": "object",
      "additionalProperties": false,
      "required": ["regime_id", "scheme", "label"],
      "properties": {
        "regime_id": { "$ref": "envelope.schema.json#/$defs/id" },
        "scheme": { "enum": ["all", "vix_level", "term_structure"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "benchmark_model_id", "models", "horizons", "values", "n", "dm_p_vs_benchmark"],
      "properties": {
        "target_id": { "$ref": "envelope.schema.json#/$defs/id" },
        "benchmark_model_id": { "$ref": "envelope.schema.json#/$defs/id" },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "envelope.schema.json#/$defs/id" }
        },
        "horizons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "envelope.schema.json#/$defs/horizon" }
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bias", "rmse", "mae", "mape", "qlike"],
          "properties": {
            "bias": { "$ref": "#/$defs/numberCube" },
            "rmse": { "$ref": "#/$defs/nonNegativeCube" },
            "mae": { "$ref": "#/$defs/nonNegativeCube" },
            "mape": { "description": "Fraction, not percent.", "$ref": "#/$defs/nonNegativeCube" },
            "qlike": { "$ref": "#/$defs/nonNegativeCube" }
          }
        },
        "n": { "$ref": "#/$defs/countCube" },
        "dm_p_vs_benchmark": {
          "description": "Two-sided DM p-value (rectangular long-run variance at lag h-1 with the HLN correction, Bartlett fallback if non-positive; ADR-0001 D4) of each model vs the benchmark on identical rows; null for the benchmark itself and suppressed cells.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sq_error", "qlike"],
          "properties": {
            "sq_error": { "$ref": "#/$defs/probabilityCube" },
            "qlike": { "$ref": "#/$defs/probabilityCube" }
          }
        }
      }
    },
    "numberCube": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/nullableNumber" } } } }
    },
    "nonNegativeCube": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/nullableNonNegative" } } } }
    },
    "probabilityCube": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/nullableProbability" } } } }
    },
    "countCube": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } }
    }
  }
}
