        <mxCell id="node_protocol_mod" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4338CA&quot;&gt;&lt;b&gt;PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ivf.protocol&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;strict readers of every config; protocol_hash = SHA-256 of the canonical JSON; freeze_data_end and its freeze record&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=16;verticalAlign=middle;shadow=1;" vertex="1" parent="lane_core">
