---
title: "implied-vol-forecasting system architecture (M0-M6)"
---
flowchart TB
    subgraph external["External"]
        cboe(["CBOE index CSVs\ncdn.cboe.com .../daily_prices/{SYM}_History.csv, 307 to cdn-api.cboe.com"])
        fred(["FRED *CLS series\nfallback#58; only fills dates missing from Cboe"])
        yfinance(["yfinance\n^GSPC and other underlyings, VXX, SVXY; auto_adjust=False"])
        sharpe{{"sharpe-observatory scripts/metrics.py\nPSR, expected max SR, DSR (MIT, reused)"}}
    end
    subgraph core["Python core (src/ivf)"]
        cli["ivf.data.cli\npython -m ivf.data fetch | build-interim | verify | check | eda; --synthetic switches the root and the protocol"]
        protocol_mod["ivf.protocol\nstrict readers of every config; protocol_hash = SHA-256 of the canonical JSON; freeze_data_end and its freeze record"]
        repo_guard["ivf.repo_guard\nlicensing guard (ADR 0001 D2)#58; refuses a data root (and its raw, interim, processed, eda, app-data folders) or an export folder inside a git checkout, by device and inode of every ancestor and by any .git entry; write_file, the one writer, checks each folder again at write time; exit 3"]
        raw_store["ivf.data.raw\nstore_snapshot#58; temp file, SHA-256, os.link to {sha256}.csv if absent; append-only provenance log"]
        fetch["ivf.data.fetch\nnetwork_get is the only network call; skip within --max-age 1 day; yfinance bytes fixed by yfinance_csv_bytes"]
        synthetic["ivf.data.synthetic\nseeded generator with known truth#58; AR(1) ln VIX, GARCH(1,1) returns; hand-set parameters, not fitted"]
        build_interim["ivf.data.build_interim\nstrict parse; typed, deduplicated, one table per source kind; latest snapshot unless --snapshot"]
        verify["ivf data verify\nre-hash every raw file and cross-check the log; fail on any mismatch"]
        check_mod["ivf.data.check\ndata_check, gap policy G1-G5, settled data_end; --freeze-data-end writes it once, with a freeze record; check fails if the protocol no longer matches the record"]
        calendar_mod["ivf.data.calendar\nmaster calendar from XNYS sessions, from dates alone; first fold cutoff"]
        features["ivf.features.build\ntrailing windows only (L1)#58; feature, target_value, regime_label; is_backwardation, term_structure_panel (L5)"]
        eda_mod["ivf.eda\npure statistics#58; ACF, Ljung-Box, AR(1) half-life, ADF/KPSS, implied-realised gap, vol-of-vol, term structure"]
        process_mod["ivf.data.process\nrun_id; refuses a failed data_check; writes the processed tables and the local EDA report"]
        splits["ivf.evaluation.splits\nexpanding window, 63-session folds, shared by every model"]
        models[["ivf.models\nrw, hist_mean, ARIMA, HAR (M2); GARCH/GJR/EGARCH on S#38;P 500 returns for rv21, har_rv, vix_implied, ARIMA-GARCH on ln VIX, d = 0 (M3); lstm_log on vix_level and rv21, 5-seed mean, retrained every 4th cutoff (M4); params frozen within a fold"]]
        evaluation["ivf.evaluation\npython -m ivf.evaluation report (M5)#58; RMSE, MAE, MAPE, QLIKE, bias by regime; DM (fixed-b primary) with Holm; MZ (Hansen-Hodrick); walk-forward calibration variant; dev only, holdout refused on real data"]
        backtest["ivf.backtest\nVXX/SVXY signals executed at close of t+1 (L7), costs, PSR/DSR; the one holdout look (M6)#58; preflight, record, holdout refits (ivf.models.holdout), M5 holdout report, backtest"]
        ivf_reports["ivf.reports\ncommits only publication set P (unitless ratios, 2 dp tests); one release per frozen data_end; needs a clean tree"]
    end
    subgraph storage["Storage"]
        configs[("configs/*.yaml\nM1#58; protocol.yaml, protocol.synthetic.yaml and their freeze records (protocol*.freeze.json), iv_indices.yaml, instruments.yaml; M2#58; models.yaml (model_def and the baseline settings); M3#58; its garch block (innovation rule, ARIMA-GARCH order); M6#58; backtest.yaml (pre-registered strategy_def rows, costs, trial-log location) and instruments.yaml's tradable_segments. Committed")]
        raw[("ROOT/raw/{source}/{symbol}/{sha256}.csv\nbytes as downloaded; never committed")]
        prov[("ROOT/raw/provenance.jsonl\nappend-only, one line per fetch, written even if unchanged")]
        synth_raw[("ROOT/synthetic/raw/\nCboe-shaped and Yahoo-shaped CSVs named by sha256, with their own provenance.jsonl; never committed")]
        interim[("ROOT/interim/{table}.parquet\niv_index_daily, price_daily; every row keeps raw_sha256")]
        build_report[("ROOT/interim/build_report.json\nper raw file#58; raw_sha256, fetched_at, rows, duplicates dropped; local, never committed")]
        processed[("ROOT/processed/run_id=#lt;id#gt;/{table}.parquet\nM1#58; run_input, calendar, data_check, feature, target_value, regime_label, eda_stat; M2 (python -m ivf.models baselines)#58; fold, fit, forecast, metric, and calendar.fold_id; M3 (python -m ivf.models garch) merges its rv21 and arima_garch_log rows into the same fit, forecast and metric tables; M4 (python -m ivf.models lstm, after garch) merges lstm_log rows (one fit row per seed) and writes forecast_member; runs.parquet beside it")]
        eda_dir[("ROOT/eda/#lt;run_id#gt;/eda_report.json\nevery EDA number, for reading locally; never committed (ADR 0001 D2)")]
        forecasts[("forecast and fit tables\nunder processed/run_id=#lt;id#gt;/; key (run_id, model_id, target_id, origin_date, horizon)")]
        results[("metric, dm_test, mz_regression, backtest_daily, strategy_summary\nunder processed/run_id=#lt;id#gt;/; M5 writes evaluation/period=dev/ (metric, dm_test, mz_regression, calibration, calibration_summary, report_meta.json)")]
        reports_dir[/"reports/*.agg.csv\ncommitted#58; publication set P only (unitless, rounded), source_dirty = false"/]
        schemas[("schemas/app-data/\nJSON Schemas#58; the single source of truth for the contract")]
        synth_json[/"app/public/data/synthetic/*.json\ncommitted fixture; data_mode synthetic"/]
        real_json[/"ROOT/app-data/real/*.json\nnever in the repo tree; the Vite dev server serves it in dev only"/]
    end
    subgraph tooling["Tooling"]
        export["tools/export_app_data.py\nreshape, round, validate, write; computes no new number (D1). M1 real#58; ribbon from interim iv_index_daily, first session with all five tenors to data_end"]
        export_check["export_app_data.py --mode synthetic --check\nregenerate in a temp dir and compare with the committed fixture"]
        scan_real["tools/licensing/scan_real_rows.py\nlocal only, not a test#58; flags a repo line that holds a raw row, a dated raw value (any date spelling), a run of 3 or more consecutive raw values, a raw file size or a raw SHA-256; prints file#58;line and a count, never the text; exit 0 clean, 1 flagged, 2 no raw data"]
        build_nb["tools/build_notebooks.py\n--check is the notebook sync test"]
        notebooks[/"notebooks/\ngenerated from src/ivf; never hand-edited"/]
    end
    subgraph app["App"]
        loader["app/src/lib loaders\ncheck envelope and invariants, show the data_mode badge; compute nothing"]
        page_ribbon("Term-structure ribbon (3D)\nterm_structure.json, series")
        page_race("Model race\nmodel_race.json, series")
        page_surface("Error surface (3D)\nerror_surface.json, aggregate")
        page_equity("Equity curve\nequity_curves.json, series")
        dist_guard["npm run verify\nfails if any file in dist/ has data_mode real"]
    end
